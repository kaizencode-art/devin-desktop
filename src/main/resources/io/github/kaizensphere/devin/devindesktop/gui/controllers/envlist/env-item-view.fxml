<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox fx:id="container"  alignment="CENTER_LEFT" minHeight="44.0" spacing="15" styleClass="list-item"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.kaizensphere.devin.devindesktop.gui.controllers.envlist.EnvItemCellController"
      onMouseClicked="#onContainerClick"
     >
    <VBox spacing="4">
        <Label fx:id="titleLabel" styleClass="item-title" text="Title 1" />
        <Label fx:id="descriptionLabel" styleClass="item-description" text="Desciption 1" />
    </VBox>
    <Region HBox.hgrow="ALWAYS" />
    <FontIcon fx:id="statusIcon" iconLiteral="fas-circle" styleClass="status-warning" />
   <padding>
      <Insets bottom="10.0" top="10.0" />
   </padding>
</HBox>
