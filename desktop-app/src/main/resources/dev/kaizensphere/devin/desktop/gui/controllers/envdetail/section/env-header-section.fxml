<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import javafx.geometry.Insets?>
<VBox  fx:controller="dev.kaizensphere.devin.desktop.gui.controllers.envdetail.section.EnvHeaderSectionController"
        xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <HBox fx:id="titleStatusContainer" spacing="10">
        <children>
            <Label fx:id="titleLabel" styleClass="title-label" text="Titre 1"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="status-label" text="[Active]"/>
            <FontIcon fx:id="statusIcon" iconLiteral="fas-circle" styleClass="status-valid"/>
        </children>
    </HBox>

    <Separator styleClass="separator-line"/>


    <VBox fx:id="descriptionLastUpdateContainer" spacing="10">
        <children>
            <HBox>
                <Label fx:id="lastUpdateTitleLabel" styleClass="description-bold" text="Last Update:"/>
                <Label fx:id="lastUpdateLabel" text="2025-03-07 by user_x">
                    <padding>
                        <Insets left="5" />
                    </padding>
                </Label>
            </HBox>
        </children>
    </VBox>
</VBox>
